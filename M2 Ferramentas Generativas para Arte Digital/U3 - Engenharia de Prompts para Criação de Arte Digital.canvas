		{"id":"0c2e9ebf6b6ced29","type":"text","text":"#### Comparações Dalle\n* Material x Teste","x":760,"y":1380,"width":471,"height":84},
		{"id":"1435a551aa8f2890","type":"text","text":"# U3.  Engenharia de Prompts para Criação de Arte Digital","x":-120,"y":1380,"width":519,"height":82},
		{"id":"e8c9898ad0dc3226","type":"text","text":"**Objetivo**: \nEstruturar descrições específicas e eficazes para que a IA interprete corretamente os elementos visuais desejados","x":279,"y":1200,"width":471,"height":100},
