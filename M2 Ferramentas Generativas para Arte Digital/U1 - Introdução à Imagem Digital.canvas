		{"id":"52e8d82f5a86b34c","x":3666,"y":-163,"width":250,"height":240,"type":"text","text":"![[Genai-Turma2/Trilha1/M2 Ferramentas Generativas para Arte Digital/assets/U1/discretizacao.png]]"},
		{"id":"646c2d04dae09d55","type":"text","text":"![[Genai-Turma2/Trilha1/M2 Ferramentas Generativas para Arte Digital/assets/U1/onda_freq.png]]","x":1606,"y":-1344,"width":765,"height":480},
		{"id":"1847146ce8487845","type":"text","text":"![[visao.png]]","x":1606,"y":-1850,"width":746,"height":430},
		{"id":"66d82b3e411cd34b","type":"text","text":"**Onda**\n![[onda.png]]","x":2551,"y":-1316,"width":392,"height":259},
		{"id":"89dee06080758ee9","type":"text","text":"**Frequência**\n* Quantidade de vezes que a crista passa por um ponto em 1 segundo","x":2551,"y":-1000,"width":519,"height":112},
		{"id":"f19394cc9de8cf32","type":"text","text":"* Luz sobre o objetos emitem diferentes comprimentos de onda. \n* São captadas pela visão e processado pelo cérebro \n* Permite distinguir cores, formas e profundidades","x":2551,"y":-1690,"width":519,"height":110}
