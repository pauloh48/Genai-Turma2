		{"id":"3657fb4339fd289d","type":"file","file":"GenAi/assets/T1_M2/watermark_leaf_veins_gray_dalle.png","x":2019,"y":4660,"width":400,"height":400},
		{"id":"1d3a2aa7257f58e2","type":"file","file":"GenAi/assets/T1_M2/watermark_leaf_veins_gray_mid.png","x":2440,"y":4660,"width":400,"height":400},
		{"id":"0542ed01f76353ff","type":"text","text":"Prompt 2: The watermark for a company where the brand is a leaf made of integrated circuit. The veins of the leaf should be made of electronic components and the image should be in gray color with no background","x":2372,"y":4360,"width":536,"height":129},
